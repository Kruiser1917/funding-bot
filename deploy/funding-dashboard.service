[Unit]
Description=OKX Funding Rate Bot - Web Dashboard
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/opt/funding-bot
ExecStart=/opt/funding-bot/venv/bin/python dashboard.py
Restart=always
RestartSec=10
EnvironmentFile=/opt/funding-bot/.env

StandardOutput=journal
StandardError=journal
SyslogIdentifier=funding-dashboard

[Install]
WantedBy=multi-user.target
