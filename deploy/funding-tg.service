[Unit]
Description=OKX Funding Rate Bot - Telegram Daemon
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/opt/funding-bot
ExecStart=/opt/funding-bot/venv/bin/python tg_daemon.py
Restart=always
RestartSec=10
EnvironmentFile=/opt/funding-bot/.env

StandardOutput=journal
StandardError=journal
SyslogIdentifier=funding-tg

[Install]
WantedBy=multi-user.target
